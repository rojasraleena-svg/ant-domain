# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Database
DATABASE_URL=postgresql://postgres.[your-project-ref]:[your-db-password]@aws-0-[region].pool.supabase.com:6543/postgres

# AI（可选，用于日志摘要等）
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
